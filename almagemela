<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AlmaPrueba1</title>
<style>
  body { background: #FFEB3B; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0; font-family:sans-serif; padding:20px; }
.card { background:white; padding:30px; border-radius:24px; width:100%; max-width:420px; text-align:center; border:2.5px solid #111; }
.pregunta { font-size:23px; font-weight:800; margin-bottom:20px; }
  input, select { width:90%; padding:14px; border-radius:12px; border:2px solid #111; background:#FFF9C4; font-weight:600; }
  button { width:95%; padding:14px; background:#111; color:#FFEB3B; border:none; border-radius:12px; font-weight:bold; margin-top:20px; }
  #barra { height:6px; background:#f0e68c; border-radius:10px; margin-bottom:20px; } #progreso { height:100%; background:#111; width:0%; transition:.5s; }
  #foto-final { display:none; } #foto-final img { width:100%; border-radius:15px; margin-top:15px; border:2.5px solid #111; }
  .error { display:none; color:red; font-size:13px; margin-top:10px; }
</style>
</head>
<body>
<div class="card" id="app">
  <div id="barra"><div id="progreso"></div></div>
  <div id="contenido-pregunta"></div>
  <p id="error-msg" class="error">Responde para continuar</p>
  <button onclick="siguiente()">Siguiente →</button>
</div>
<div class="card" id="foto-final">
  <h2>Gracias 💛</h2>
  <img src="foto.jpg">
</div>
<script>
const GOOGLE_SHEETS_URL = "https://script.google.com/macros/s/AKfycbySsP6O2zndI5wLc0VrFlyzinc5K4A4hxgeUNh3GIEOD8-cLCGHUxCYC7x33VSky3WXjA/exec";
const preguntas = [
  { q: "¿Cuál es tu nombre?", tipo: "text", key: "Nombre" },
  { q: "¿Cuántos años tienes?", tipo: "number", key: "Edad" },
  { q: "¿Cuál es tu signo zodiacal?", tipo: "select", opciones: ["Aries","Tauro","Géminis","Cáncer","Leo","Virgo","Libra","Escorpio","Sagitario","Capricornio","Acuario","Piscis"], key: "Signo" },
  { q: "¿Tienes pareja?", tipo: "select", opciones: ["Sí","No"], key: "Tiene pareja" },
  { q: "¿Confías en tu pareja?", tipo: "select", opciones: ["Sí, totalmente","No mucho","Prefiero no responder"], key: "Confianza" },
  { q: "¿Dejarías a tu pareja si no fuera tu alma gemela?", tipo: "select", opciones: ["Sí","No","No lo sé"], key: "Dejaría a su pareja" },
  { q: "¿Has respondido con la verdad?", tipo: "select", opciones: ["Sí, 100%","Quizá mentí en algo"], key: "Dijo la verdad" }
];
let paso = 0; let respuestas = {};
function mostrarPregunta(){
  const p = preguntas;
  document.getElementById('progreso').style.width = (paso/preguntas.length*100)+'%';
  let html = `<div class="pregunta">${p.q}</div>`;
  if(p.tipo==='select'){
    html+=`<select id="input-actual"><option value="">-- Elige --</option>`;
    p.opciones.forEach(o=>html+=`<option value="${o}">${o}</option>`);
    html+=`</select>`;
  }else{
    html+=`<input id="input-actual" type="${p.tipo}" placeholder="Escribe aquí...">`;
  }
  document.getElementById('contenido-pregunta').innerHTML = html;
}
async function siguiente(){
  const input = document.getElementById('input-actual');
  if(!input || !input.value.trim()){ document.getElementById('error-msg').style.display='block'; return; }
  document.getElementById('error-msg').style.display='none';
  respuestas[preguntas.key] = input.value;
  paso++;
  if(paso < preguntas.length){ mostrarPregunta(); }
  else{
    try{ await fetch(GOOGLE_SHEETS_URL, {method:"POST", mode:"no-cors", body:JSON.stringify(respuestas)}); }catch(e){}
    document.getElementById('app').style.display='none';
    document.getElementById('foto-final').style.display='block';
  }
}
mostrarPregunta();
</script>
</body>
</html>